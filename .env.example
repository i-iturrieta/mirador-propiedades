# Database (Neon, Supabase, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/mirador?schema=public"

# Auth.js v5
# Generate with: npx auth secret
AUTH_SECRET="change-me-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Admin user created by `prisma db seed` (required for the seed to run)
SEED_ADMIN_EMAIL="alejandra@miradorpropiedades.cl"
SEED_ADMIN_PASSWORD="cambia-esto-antes-del-seed"

# Resend (transactional email)
RESEND_API_KEY=""
CONTACT_EMAIL_TO="alejandra@miradorpropiedades.cl"
CONTACT_EMAIL_FROM="contacto@miradorpropiedades.cl"

# WhatsApp number in international format without + or spaces
WHATSAPP_NUMBER="56988040592"
NEXT_PUBLIC_WHATSAPP_NUMBER="56988040592"

# Cloudinary (optional for image hosting)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 (image uploads from the admin)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL of the bucket (no trailing slash), e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=""

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
